{
  "hosting": {
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/home/index.html"
      },
      {
        "source": "/home",
        "destination": "/home/index.html"
      },
      {
        "source": "/pricing",
        "destination": "/pricing.html"
      },
      {
        "source": "/terms",
        "destination": "/terms.html"
      },
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/guarantee",
        "destination": "/guarantee.html"
      },
      {
        "source": "/account-deletion",
        "destination": "/account-deletion.html"
      },
      {
        "source": "/android",
        "destination": "/android/index.html"
      },
      {
        "source": "/vibhavgpt-windows",
        "destination": "/vibhavgpt-windows/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "predeploy": [
      "npm --prefix frontend run build"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
