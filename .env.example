# Frontend build (frontend/), set on the frontend service
# API origin for the web app; leave empty in development to use the local /api proxy (production: https://api.example.com).
VITE_API_URL=
VITE_SENTRY_DSN=
VITE_TURNSTILE_SITE_KEY=

# Express backend
NODE_ENV=development
PORT=3001
UPLOAD_STORAGE_PATH=.data/uploads
CLIENT_ORIGINS=http://localhost:5173
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
# Set to false to load the API without starting the HTTP listener (used by scripts).
START_SERVER=true
# URL scheme the mobile apps use for sign-in return links.
MOBILE_AUTH_SCHEME=vibhavgpt
# Passkey origin and relying-party ID; default to the first CLIENT_ORIGINS entry and its hostname.
PASSKEY_ORIGIN=http://localhost:5173
PASSKEY_RP_ID=localhost
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=VibhavGPT Security <security@pansophy.com>
SENTRY_DSN=
TURNSTILE_SECRET_KEY=
# Comma-separated production hostname allow-list. Defaults to vibhavgpt.com in production.
TURNSTILE_ALLOWED_HOSTNAMES=
# Moderation: a chat-completions URL and model that classify each message.
# The key falls back to INFERENCE_PRIMARY_API_KEY when left empty.
MODERATION_API_URL=https://moderation.example.com/v1/chat/completions
MODERATION_API_KEY=
MODERATION_MODEL=example/moderation-model
# With its own MODERATION_API_KEY the classifier runs only when this is true.
# On the shared primary key it follows CHAT_LUMEN_PRIMARY_APPROVED instead, and
# only when MODERATION_API_URL is on the primary stage's host. Otherwise only
# the local rules apply.
MODERATION_DATA_POLICY_APPROVED=false

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Inference stages. Each stage is a standard chat-completions API:
# a base URL without a trailing slash (the code appends /chat/completions)
# and a server-side key. A stage with no URL or key is skipped.
# Primary: Lumen's first stage, search-intent classification and memory
# extraction.
INFERENCE_PRIMARY_BASE_URL=https://primary.example.com/v1
INFERENCE_PRIMARY_API_KEY=
# Gateway, secondary and reserve: Lumen's fallback stages, tried in order.
INFERENCE_GATEWAY_BASE_URL=https://gateway.example.com/v1
INFERENCE_GATEWAY_API_KEY=
INFERENCE_SECONDARY_BASE_URL=https://secondary.example.com/v1
INFERENCE_SECONDARY_API_KEY=
INFERENCE_RESERVE_BASE_URL=https://reserve.example.com/v1
INFERENCE_RESERVE_API_KEY=
# Router: a provider-routing API used by Nova, Nebula and Vesper, and for
# image generation (BASE_URL/images) and usage lookups (BASE_URL/generation).
INFERENCE_ROUTER_BASE_URL=https://router.example.com/api/v1
INFERENCE_ROUTER_API_KEY=
# Direct: Study, and Comet voice (BASE_URL/realtime/calls). Server-side only;
# never expose this key to a client.
INFERENCE_DIRECT_BASE_URL=https://direct.example.com/v1
INFERENCE_DIRECT_API_KEY=

# Chat lineup. Required server values, with no model fallback defaults.
# Model identifiers are whatever the stage's API expects.
CHAT_MODEL_LUMEN=example/lumen-model
# Set to true once the primary stage's data policy is reviewed for Lumen.
# This also allows search intent, memory extraction and (on the shared key)
# moderation, which use the same provider.
CHAT_LUMEN_PRIMARY_APPROVED=false
# Optional: the exact model that was reviewed. When set, any other
# CHAT_MODEL_LUMEN closes the primary stage until this is updated.
CHAT_LUMEN_PRIMARY_APPROVED_MODEL=
CHAT_MODEL_LUMEN_FALLBACK_1=example/lumen-fallback-1
CHAT_MODEL_LUMEN_FALLBACK_2=example/lumen-fallback-2
CHAT_MODEL_LUMEN_FALLBACK_3=example/lumen-fallback-3
# Data-policy approval for each fallback stage (gateway = FALLBACK_1,
# secondary = FALLBACK_2, reserve = FALLBACK_3). A stage is used only when it
# is approved AND its *_APPROVED_MODEL equals its configured model exactly;
# otherwise it is skipped without a request. A model the provider chooses
# itself (auto, auto:free) can never be approved.
CHAT_LUMEN_GATEWAY_APPROVED=false
CHAT_LUMEN_GATEWAY_APPROVED_MODEL=
CHAT_LUMEN_SECONDARY_APPROVED=false
CHAT_LUMEN_SECONDARY_APPROVED_MODEL=
CHAT_LUMEN_RESERVE_APPROVED=false
CHAT_LUMEN_RESERVE_APPROVED_MODEL=
CHAT_MODEL_NOVA=example/nova-model
CHAT_MODEL_STUDY=example/study-model
CHAT_MODEL_NEBULA=example/nebula-model
# Reviewed for the selected route; reverify before changing that route.
CHAT_NEBULA_DATA_POLICY_VERIFIED=false
CHAT_MODEL_VESPER=example/vesper-model
# Comma-separated provider allow-lists the router may use for each tier,
# sorted by price on each call. A tier with an empty list is not served.
CHAT_NOVA_ROUTE_PROVIDERS=example-provider-a,example-provider-b
CHAT_NEBULA_ROUTE_PROVIDERS=example-provider-c,example-provider-d
# Small model on the primary stage that classifies whether to search.
SEARCH_INTENT_MODEL=example/search-intent-model
# Model on the primary stage that extracts memory facts.
MEMORY_EXTRACTION_MODEL=example/memory-model
# Image model on the router stage.
IMAGE_GENERATION_MODEL=example/image-model

# Comet voice, on the direct stage.
VOICE_REALTIME_MODEL=example/realtime-voice-model
VOICE_TRANSCRIPTION_MODEL=example/transcription-model
VOICE_NAME=example-voice

# Comma-separated provider and model-family names that must never be saved
# as memory facts about the assistant. A space also matches no space.
PROVIDER_NAME_TERMS=example vendor,example model family

# Comma-separated terms a display name may not contain (account names and the
# survey's "Call me" name). Matching ignores case, accents, look-alike letters,
# leetspeak, repeated letters and separators. Terms under five letters match
# only as whole words. Unset: names get only the basic sanity checks.
NAME_BLOCKLIST=example blocked term,anotherexample

# Web search: a search API URL and key.
SEARCH_API_URL=https://search.example.com/search
SEARCH_API_KEY=

# Weather: a current-weather API URL, key, and the attribution name passed to
# the model with each observation.
WEATHER_API_URL=https://weather.example.com/data/2.5/weather
WEATHER_API_KEY=
WEATHER_SOURCE_NAME=Weather service

# Development scripts only (scripts/verify-transcription-vocabulary.js).
TRANSCRIPTION_MODEL=example/transcription-model

# Verification & Test Scripts
# Read only by the scripts in scripts/, never by the API or the web app. Every
# line below is commented out on purpose: `cp .env.example .env` must not arm
# any of them. Set one in your shell for a single run, or uncomment it here.
# Values shown are placeholders, or the script's own default.

# Address of the running API that the upload checks call (default shown).
# UPLOAD_TEST_BASE_URL=http://127.0.0.1:3001
# Web origin sent with those requests (default shown).
# UPLOAD_TEST_ORIGIN=http://localhost:5173
# Set to true to skip the check that the uploaded file exists in local storage
# (use it when the API runs somewhere else).
# UPLOAD_TEST_SKIP_LOCAL_FILE_CHECK=false

# The same three settings for the image upload check.
# IMAGE_UPLOAD_TEST_BASE_URL=http://127.0.0.1:3001
# IMAGE_UPLOAD_TEST_ORIGIN=http://localhost:5173
# IMAGE_UPLOAD_TEST_SKIP_LOCAL_FILE_CHECK=false

# Voice transcription checks: a short audio file on your machine and its MIME
# type (the type defaults to audio/wav). The vocabulary check also needs
# TRANSCRIPTION_MODEL above.
# VOICE_TEST_FILE=/path/to/sample.wav
# VOICE_TEST_MIME=audio/wav

# Where the sports search quality check writes its JSON report. No report is
# written when this is empty.
# SEARCH_REPORT_PATH=.data/search-report.json

# Config file the study verification script tells dotenv to use. The script sets
# this itself so it never reads your real .env; you do not need to set it.
# DOTENV_CONFIG_PATH=.env.study-verification-unused

# WARNING: scripts/cleanup-ui-auth-test.js DELETES the account with this email
# and all of its data. Use it only against a throwaway test account, and never
# leave it set in a shared or production environment.
# TEST_EMAIL=test-account@example.invalid

# WARNING: scripts/reconcile-credit-customers.js --apply refuses to change
# historical payment associations unless this is exactly "relink". Set it for
# one deliberate run only, never in a saved .env.
# CONFIRM_GUEST_CREDIT_RECONCILIATION=relink

# Study Writing Tools (AI Detector and Humanizer). Optional upstream rewrite
# service, called server to server only; both are needed. Without them, or if
# it fails, the Humanizer uses the Study model (CHAT_MODEL_STUDY).
# CLEVER_AI_API_URL=
# CLEVER_AI_API_KEY=
