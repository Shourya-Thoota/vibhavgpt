{
  "name": "vibhavgpt-desktop",
  "productName": "VibhavGPT",
  "version": "1.2.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Windows desktop shell for VibhavGPT",
  "author": "VibhavGPT",
  "main": "main.js",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3"
  },
  "scripts": {
    "dev": "electron .",
    "dev:local": "concurrently --kill-others --names web,desktop \"npm run dev --prefix ../frontend\" \"wait-on http://localhost:5173 && electron . --app-url=http://localhost:5173/app\"",
    "icon": "node scripts/make-icon.mjs",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "electron": "^42.11.9",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^2.1.8",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.pansophy.vibhavgpt.desktop",
    "productName": "VibhavGPT",
    "copyright": "VibhavGPT",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "build/icon.ico",
      "package.json"
    ],
    "protocols": [
      {
        "name": "VibhavGPT",
        "schemes": [
          "vibhavgpt"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VibhavGPT",
      "uninstallDisplayName": "VibhavGPT",
      "deleteAppDataOnUninstall": true,
      "artifactName": "VibhavGPT-Setup-x64.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Shourya-Thoota",
        "repo": "vibhavgpt-releases",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "electron@38.8.6": true
  }
}
