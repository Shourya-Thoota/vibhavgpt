# Dependencies and build artifacts
node_modules/
dist/
dist-ssr/
coverage/

# Environment files (the example file is safe to commit)
.env
.env.*
!.env.example
*.local
.*-token-*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Editor and operating-system files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.tmp/
.vscode/
previous/
previews/

# Local-only files: assistant settings and the dev preview mock
.claude/
frontend/src/dev-preview-mock.js

# Credentials, signing files and release binaries (never commit these).
# Local key files
.*-test-key
.*-key
*.key
*.pem
id_rsa*
service-account*.json
google-services.json
GoogleService-Info.plist
# Android signing, in any directory (mobile-capacitor/ included)
*.jks
*.keystore
keystore.properties
signing.properties
direct-signing.properties
local.properties
# Release binaries are never committed. Installers and APKs are published
# in the separate vibhavgpt-releases repository (see desktop/README.md and
# mobile-capacitor-direct/README.md); the site only redirects to them.
# Any installer or package, in any directory:
*.aab
*.apk
*.exe
*.blockmap
# The old local download folder (the site once served files from here). Kept
# ignored as a whole, so nothing placed in it can be committed by accident.
frontend/public/downloads/
